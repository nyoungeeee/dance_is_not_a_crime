# 서버(b201)의 ~/dance/.env 로 복사해서 채운다. 이 파일(.env)은 git에 올리지 않는다.
PUBLIC_URL=https://dance-is-not-a-crime.b201.kr
# openssl rand -hex 32
SESSION_SECRET=
# Kakao Developers > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 카카오 로그인 > 보안 > Client Secret (사용함으로 켠 경우)
KAKAO_CLIENT_SECRET=
# 앱 키 > Admin 키 (탈퇴 시 카카오 연결 해제)
KAKAO_ADMIN_KEY=
# 비우면 ${PUBLIC_URL}/api/auth/kakao/callback
KAKAO_REDIRECT_URI=
# 운영자 카카오 회원번호(쉼표로 여러 명). 로그인 후 /api/me/kakao-id 에서 확인
ADMIN_KAKAO_IDS=
HOST_PORT=3220
