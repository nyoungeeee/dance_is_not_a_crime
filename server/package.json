{
  "name": "dance-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "prisma migrate deploy && tsc -p tsconfig.build.json && node dist/src/main.js",
    "test": "prisma generate && tsc -p tsconfig.build.json && node --test --test-concurrency=1 dist/test/api.test.js",
    "migrate": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
